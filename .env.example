# Baraka Client — environment template
#
# Copy this file to `.env` (and/or `.env.development`, `.env.production`,
# `.env.staging`) and fill in real values locally. The real `.env*` files are
# gitignored and MUST NOT be committed.
#
# IMPORTANT: Every VITE_* variable is inlined into the browser bundle at build
# time by Vite. Anything placed here is PUBLICLY VISIBLE in the shipped JS and is
# NOT a secret. Values that must stay confidential have to be handled by a backend.

# --- Public config (safe to expose in the client bundle) ---
VITE_BASE_API=https://your-api-host.example.com/
VITE_NODE_ENV=development
VITE_ROUTER_HISTORY=hash
VITE_PUBLIC_PATH=/
VITE_BOT_TYPE=B2C

# CLI-03: Google API key is exposed in the client bundle by design.
# It MUST be restricted in Google Cloud Console (HTTP referrer allowlist +
# API restrictions). Rotate the previously committed key. Placeholder only:
VITE_GOOGLE_API_KEY=your-restricted-google-api-key

